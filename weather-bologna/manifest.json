{
  "schema": 1,
  "id": "weather-bologna",
  "name": "Weather Bologna",
  "version": "1.1.0",
  "description": "Native weather widget using Open-Meteo with configurable location.",
  "provides": ["widget", "service"],
  "permissions": [],
  "entry": {
    "widget": {
      "kind": "builtin",
      "className": "com.desmond.feedpack.WeatherWidgetRenderer"
    },
    "service": {
      "kind": "builtin",
      "className": "com.desmond.feedpack.WeatherService"
    },
    "settings": {
      "kind": "file",
      "path": "settings/weather-settings.json"
    }
  }
}
